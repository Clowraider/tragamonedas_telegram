# Copy to .env and never commit .env itself.
# Example values for local development on Proxmox or Docker Compose.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (managed by Docker Compose or Proxmox)
DATABASE_URL=postgresql://slot:slot@localhost:5432/slot_machine

# Telegram Mini App integration
TELEGRAM_BOT_TOKEN=

# Application signing (for development, generate a long random string)
# In production, use a secret manager and rotate periodically.
APP_SECRET=change-me-to-a-long-random-string

# Game default (virtual credits only)
DEFAULT_BALANCE=1000
DEFAULT_STAKE=10
GAME_VERSION=classic-1
