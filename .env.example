# Copy to .env and never commit .env itself.
# Example values for local development on Proxmox or Docker Compose.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=slot
DB_PASSWORD=slot
DB_NAME=slot_machine

# Telegram Mini App integration
TELEGRAM_BOT_TOKEN=

# Application signing (for development, generate a long random string)
# In production, use a secret manager and rotate periodically.
APP_SECRET=change-me-to-a-long-random-string

# Admin Control Panel (Back-Office on dedicated port)
ADMIN_PORT=3001
ADMIN_API_KEY=admin-dev-secret-key-12345678

# Game default (virtual credits only)
DEFAULT_BALANCE=1000
DEFAULT_STAKE=10
GAME_VERSION=classic-1
