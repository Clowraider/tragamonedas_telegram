# ==============================================================================
# Slot Machine MVP - Production Deployment Environment Variables
# Copy to deploy/.env on the deployment host. NEVER commit deploy/.env to git.
# ==============================================================================

# --- Domain & TLS Configuration (Caddy) ---
# The public domain pointing to your Proxmox VM / LXC host
DOMAIN=slot.example.com
# Email used for Let's Encrypt certificate expiration notices
ACME_EMAIL=admin@example.com

# --- Application Runtime Settings ---
# In production, NODE_ENV must be production.
# Setting AUTH_MODE=development in production causes startup rejection.
NODE_ENV=production
LOG_LEVEL=info
PORT=3000

# --- PostgreSQL Database Credentials ---
POSTGRES_USER=slot
POSTGRES_PASSWORD=replace_with_a_secure_random_database_password
POSTGRES_DB=slot_machine

# --- Mandatory Production Secrets ---
# 1. Telegram Bot Token obtained from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
# 2. Cryptographic random secret for signing and internal integrity (>= 32 chars)
APP_SECRET=replace_with_a_long_random_hex_or_base64_secret_key_minimum_32_characters

# --- Authentication Configuration ---
# Production strictly accepts only "telegram" authentication
AUTH_MODE=telegram
# Maximum age of Telegram WebApp auth_date in seconds (86400 = 24 hours)
AUTH_DATE_MAX_AGE_SECONDS=86400

# --- Economy & Game Configuration ---
# Virtual credits only. No real money or cash-out operations exist.
DEFAULT_BALANCE=1000
DEFAULT_STAKE=10
GAME_VERSION=classic-1
